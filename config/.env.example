# true (default): finestra del browser Facebook/Instagram visibile normalmente.
# false: la sessione resta un browser reale non-headless (nessun compromesso
# sul rischio di rilevamento anti-bot), ma la finestra viene spostata fuori
# schermo e minimizzata subito dopo l'apertura — non compare mai all'utente.
# Non si applica al login manuale (sempre visibile, richiede interazione).
BROWSER_VISIBILE=true
